# Agent Dashboard configuration.
#
# Copy to `.env` and fill in. Every setting is an environment variable — there is
# no config file — so the same list works for `docker compose`, systemd, or a
# plain shell. Validation lives in `src/config.ts`; a bad value fails at boot
# with the offending variable named, not at the first request.
#
# Design reference: §10 Packaging and deployment.


# ── Storage ───────────────────────────────────────────────────────────────────

# Root of the runtime data directory. Holds the SQLite database and `media/`.
# Back this up: the database file plus an rsync of `media/`.
# Default: data
DATA_DIR=data


# ── Secrets ───────────────────────────────────────────────────────────────────
# All three are required. The two secrets must be at least 32 characters.

# argon2id hash of the single owner password. There is one owner; there is no
# user table (design §8). Generate one with:
#
#   node -e "import('argon2').then(a=>a.hash(process.argv[1],{type:a.argon2id}).then(console.log))" 'your-password'
#
# Quote it in a .env file — the hash contains `$`.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE$REPLACE'

# Signs the owner's session cookie. Rotating it logs the owner out.
#   openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-plus-random-characters

# HMAC key for agent tokens and for upload tokens. Agent tokens are stored as
# HMAC-SHA256 under this key, so rotating it invalidates every minted token.
#   openssl rand -hex 32
TOKEN_SECRET=replace-me-with-32-plus-random-characters


# ── Public identity ───────────────────────────────────────────────────────────

# Absolute public origin, no trailing slash. Used to build the upload URLs and
# media URLs handed to agents, so it must be what the agent can actually reach —
# your real hostname, not localhost, once this is behind a proxy.
# Default: http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173


# ── Upload limits ─────────────────────────────────────────────────────────────
# Enforced while the upload streams, not by trusting Content-Length (design §6).

# Maximum bytes for an image upload. Default: 10485760 (10 MiB)
MAX_IMAGE_BYTES=10485760

# Maximum bytes for a video upload. Default: 209715200 (200 MiB)
MAX_VIDEO_BYTES=209715200


# ── Approval gate ─────────────────────────────────────────────────────────────

# Seconds `request_approval` parks waiting for the owner before handing the agent
# a `pending` result to poll on. Must stay under the 60 second tool timeout common
# to MCP clients, so the maximum accepted is 59 (design §5).
# Default: 55
HOLD_S=55


# ── Read by the Node adapter, not by this app ─────────────────────────────────
# Listed for completeness when self-hosting the built server (`node build`).

# Port to listen on. Default: 3000
# PORT=3000

# Interface to bind. Default: 0.0.0.0
# HOST=0.0.0.0

# Origin used for CSRF checks by adapter-node. Set this to PUBLIC_BASE_URL.
# ORIGIN=http://localhost:3000

# Request body cap for the adapter. Uploads stream past this via their own route,
# but a value far below MAX_VIDEO_BYTES will reject them. Default: 512K
# BODY_SIZE_LIMIT=512K
