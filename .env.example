# Agent Dashboard configuration.
#
# Copy to `.env` and fill in. Every setting is an environment variable — there is
# no config file — so the same list works for `docker compose`, systemd, or a
# plain shell. Validation lives in `src/config.ts`; a bad value fails at boot
# with the offending variable named, not at the first request.
#
# With Docker: `cp .env.example .env`, fill in the three secrets and
# PUBLIC_BASE_URL, then `docker compose up -d`. Compose reads this file and sets
# DATA_DIR=/data (the named volume), PORT=8010 and ORIGIN=$PUBLIC_BASE_URL for
# you, so those three are the ones not to bother changing here.
#
# Design reference: §10 Packaging and deployment.


# ── Storage ───────────────────────────────────────────────────────────────────

# Root of the runtime data directory. Holds the SQLite database and `media/`.
# Back it up with `agent-dashboard backup <file>` plus an rsync of `media/`; the
# `sqlite3` CLI is not needed. Under Docker this is always /data, the volume.
# Default: data
DATA_DIR=data


# ── Secrets ───────────────────────────────────────────────────────────────────
# All three are required. The two secrets must be at least 32 characters.

# argon2id hash of the single owner password. There is one owner; there is no
# user table (design §8). Generate one with:
#
#   docker compose run --rm --no-deps dashboard hash-password 'your password'
#
# or, without Docker, after `npm run build:cli`:
#
#   node build/cli.js hash-password 'your password'
#
# Quote it in a .env file — the hash contains `$`.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE$REPLACE'

# Signs the owner's session cookie. Rotating it logs the owner out.
#   openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-plus-random-characters

# HMAC key for agent tokens and for upload tokens. Agent tokens are stored as
# HMAC-SHA256 under this key, so rotating it invalidates every minted token.
#   openssl rand -hex 32
TOKEN_SECRET=replace-me-with-32-plus-random-characters


# ── Public identity ───────────────────────────────────────────────────────────

# Absolute public origin, no trailing slash. Used to build the upload URLs and
# media URLs handed to agents, so it must be what the agent can actually reach —
# your real hostname, not localhost, once this is behind a proxy. An agent handed
# a 127.0.0.1 upload URL cannot upload anything. If the box cannot resolve its own
# public name, add a 127.0.0.1 entry for it to /etc/hosts rather than changing
# this. Compose also copies this into ORIGIN, which the CSRF check compares the
# browser's Origin header against.
# Default: http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173


# ── Upload limits ─────────────────────────────────────────────────────────────
# Enforced while the upload streams, not by trusting Content-Length (design §6).

# Maximum bytes for an image upload. Default: 10485760 (10 MiB)
MAX_IMAGE_BYTES=10485760

# Maximum bytes for a video upload. Default: 209715200 (200 MiB)
MAX_VIDEO_BYTES=209715200


# ── Approval gate ─────────────────────────────────────────────────────────────

# Seconds `request_input` parks waiting for the owner before handing the agent
# a `pending` result to poll on. Must stay under the 60 second tool timeout common
# to MCP clients, so the maximum accepted is 59 (design §5).
# Default: 55
HOLD_S=55


# ── Read by the Node adapter, not by this app ─────────────────────────────────
# Listed for completeness when self-hosting the built server (`node build`).

# Port to listen on. The reference deployment (design §12) uses 8010, which is
# what the Caddy site block proxies to. Default: 8010
PORT=8010

# Interface to bind. Behind a reverse proxy on the same host, 127.0.0.1 keeps the
# app off the network entirely. Default: 0.0.0.0
# HOST=127.0.0.1

# Origin used for CSRF checks by adapter-node. Set this to PUBLIC_BASE_URL.
# ORIGIN=https://agents.wildware.dev

# ── Required when a reverse proxy sits in front ────────────────────────────────
# Uncomment these the moment something is proxying to this app, and not before.
#
# Turn them ON behind a proxy: otherwise `getClientAddress()` returns the socket
# peer — the proxy itself, so 127.0.0.1 for every visitor on the internet. The
# login rate limiter then treats all visitors as one client, and five wrong
# guesses from any stranger lock the owner out for fifteen minutes. The app
# refuses to start if PUBLIC_BASE_URL is https and ADDRESS_HEADER is unset, so
# the real deployment cannot forget.
#
# Leave them OFF with nothing in front: adapter-node *throws* when the named
# header is missing from a request, so with these set and no proxy adding the
# header, every direct request answers 500 — including the login POST.
#
# Caddy and nginx both set X-Forwarded-For by default. XFF_DEPTH is the number of
# proxies you control, counted from the right: 1 for a single Caddy in front.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Only if this process really does face the internet and terminate its own TLS.
# Acknowledges that the socket peer is the true client and skips the check above.
# TRUST_SOCKET_ADDRESS=true

# Request body cap enforced by the adapter BEFORE any route runs, including the
# upload route — there is no way to stream past it. The adapter's own default is
# 512K, which silently rejects every upload larger than that with a 413 the app
# never sees, so this must be at least MAX_VIDEO_BYTES or uploads break in a way
# the agent cannot diagnose. Startup fails if it is smaller.
BODY_SIZE_LIMIT=209715200

# ── Push notifications (optional) ──────────────────────────────────────────────
# Web Push is what reaches you when the dashboard is not open: an agent calls
# request_input, it stops dead, and your phone tells you. Without a keypair here
# push is simply off — the dashboard works exactly as it does now, the browser is
# never offered a subscription it could not use, and the toggle in the header
# does not appear.
#
# Generate a pair with:
#
#   docker compose exec dashboard agent-dashboard vapid-keys
#
# Both must be set, or neither: half a pair cannot sign anything, so the app
# refuses to start rather than silently disabling push on a deployment that
# plainly meant to switch it on.
#
# Every browser subscription is bound to the PUBLIC key it was created against,
# so changing these invalidates all of them and each browser has to subscribe
# again. There is no way to migrate them; they are not yours to re-issue.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Who a push service should complain to about this deployment: a mailto: address
# or an https:// URL. Defaults to PUBLIC_BASE_URL, which is already a real
# address for this deployment.
# VAPID_SUBJECT=mailto:you@example.com
