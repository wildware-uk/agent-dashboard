{
	"name": "agent-dashboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo \"\"",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check": "npm run typecheck",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --project=unit",
		"test:watch": "vitest --project=unit",
		"test:component": "vitest run --project=component",
		"test:e2e": "playwright test --pass-with-no-tests",
		"test:all": "npm run test && npm run test:component && npm run test:e2e",
		"coverage": "vitest run --project=unit --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"argon2": "^0.45.1",
		"better-sqlite3": "^13.0.3",
		"file-type": "^22.0.2",
		"markdown-it": "^15.0.0",
		"sharp": "^0.35.3",
		"ulid": "^3.0.2",
		"zod": "^4.4.3"
	},
	"description": "Self-hosted dashboard where AI coding agents report what they are doing over MCP.",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	}
}
